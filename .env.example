# ============================================================
# CampusFlow — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# ── PostgreSQL (Prisma) ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusflow?schema=public"

# ── MongoDB (Mongoose) ──────────────────────────────────────
MONGODB_URI="mongodb://localhost:27017/campusflow_events"

# ── Better Auth ─────────────────────────────────────────────
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars-here"
BETTER_AUTH_URL="http://localhost:3000"

# ── Resend (Transactional Email) ─────────────────────────────
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_secret_here"

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CampusFlow"

# ── Email ────────────────────────────────────────────────────
EMAIL_FROM="CampusFlow <noreply@campusflow.dev>"
